# ============================================================
# SiteCrew AaSS Kit: environment variables
# Copy this file to .claude/scripts/.env and fill in the values
# YOURSELF, in your editor. Never paste a token into the chat.
# .env is git-ignored. Never commit it.
# ============================================================

# === GitHub (one repository, least access) ===
# 1. Create ONE empty repository on GitHub yourself.
# 2. Create a fine-grained token for that repository only:
#    https://github.com/settings/personal-access-tokens/new
#    - Repository access: Only select repositories -> your one repo
#    - Repository permissions: Contents = Read and write
#      (Metadata = Read is added automatically)
#    - Expiration: 90 days
#    - No other permissions.
GITHUB_TOKEN=
# The repository as owner/name, e.g. jane/janes-bakery-site
GITHUB_REPO=

# === Cloudflare ===
# Custom token: https://dash.cloudflare.com/profile/api-tokens
#   Zone -> Zone -> Read and Zone -> DNS -> Edit  (both limited to your one domain)
#   Account -> Cloudflare Pages -> Edit
CF_API_TOKEN=
# Account ID: Cloudflare dashboard, your domain -> Overview -> API section
CF_ACCOUNT_ID=

# === Only if your domain is at Namecheap or Spaceship and you want the
# === kit to switch its nameservers for you (otherwise do it by hand)
# NAMECHEAP_API_USER=
# NAMECHEAP_API_KEY=
# NAMECHEAP_USERNAME=
# NAMECHEAP_CLIENT_IP=
# SPACESHIP_API_KEY=
# SPACESHIP_API_SECRET=
